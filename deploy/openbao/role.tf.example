# Terraform snippet — binds deploy/openbao/policy.hcl to this service's
# Kubernetes ServiceAccount via OpenBao's kubernetes auth method. This file
# is *illustrative*, not applied by the application; platform Terraform (or
# an equivalent `bao`/`vault` CLI bootstrap) owns the authoritative version.
#
# Assumes the "kubernetes" auth method is already enabled and configured
# against this cluster (auth/kubernetes/config) — that setup is shared
# across every IAM service and is out of scope here.
#
# ServiceAccount names/namespace must match deploy/helm's rendered
# per-workload ServiceAccounts (<fullname>-<component>, fullname
# "iam-token-service", in whichever namespace the chart is installed into). OPENBAO_ROLE (§12) defaults to
# "iam-token-service" — keep the role name below in sync with that env var.

resource "vault_policy" "iam_token_service" {
  name   = "iam-token-service"
  policy = file("${path.module}/policy.hcl")
}

# Every binary that touches OpenBao logs in to this one role from its own
# per-workload ServiceAccount (serviceAccount.perWorkload: true). They share
# policy.hcl: each needs a subset of the same path (server: write/read/delete;
# consumer: delete/list; rotator: list/read/delete; scheduler: write). The
# migrate Job never calls OpenBao and is deliberately NOT bound.
#
# serviceAccount.perWorkload: false — every workload then runs as ONE shared
# ServiceAccount, <fullname> ("iam-token-service", or serviceAccount.name),
# which must be added to bound_service_account_names below or every pod's
# OpenBao login fails ("service account name not authorized"). IRSA likewise
# becomes one role: put the union of policy-server.json and
# policy-consumer.json on serviceAccount.annotations (deploy/iam/README.md);
# the chart refuses workloadAnnotations in that mode.
#
# audience must equal the chart's openbao.tokenAudience: pods log in with a
# projected token minted for that audience only, never the default
# API-server-audience token.
resource "vault_kubernetes_auth_backend_role" "iam_token_service" {
  backend   = "kubernetes"
  role_name = "iam-token-service"
  bound_service_account_names = [
    "iam-token-service-server",
    "iam-token-service-consumer",
    "iam-token-service-rotator",
    "iam-token-service-scheduler",
    # "iam-token-service",  # add when serviceAccount.perWorkload: false
  ]
  bound_service_account_namespaces = ["iam"]
  audience                         = "openbao"
  token_policies                   = [vault_policy.iam_token_service.name]
  token_ttl                        = 900  # 15m — short-lived, proactively renewed (see policy.hcl)
  token_max_ttl                    = 3600
}
