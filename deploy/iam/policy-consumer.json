{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeOffboardingQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "${offboarding_queue_arn}"
    },
    {
      "Sid": "OffboardingDLQPermanentRejects",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "${offboarding_dlq_arn}"
    }
  ]
}
