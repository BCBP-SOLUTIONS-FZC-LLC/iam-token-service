# Terraform snippet — attach the reference policy in deploy/iam/policy.json to
# an IRSA role. This file is *illustrative*, not applied by the application.
# Platform Terraform owns the authoritative version of this resource.
#
# The SAME role must be assumable by every workload this chart creates —
# cmd/server (publishes to iam-serviceaccount-events, reads the Glue
# registry), cmd/consumer (consumes the offboarding queue), and
# cmd/rotator (no AWS calls today, but shares the ServiceAccount) — one
# ServiceAccount, one role (see deploy/helm/values.yaml's
# serviceAccount.annotations, which all three workloads reference via the
# same serviceAccountName helper).

# 1. Trust policy — the ServiceAccount `iam-token-service` in namespace
#    `iam` assumes this role via IRSA.
data "aws_iam_policy_document" "iam_token_service_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.eks.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:sub"
      values   = ["system:serviceaccount:iam:iam-token-service"]
    }
    condition {
      test     = "StringEquals"
      variable = "${replace(aws_iam_openid_connect_provider.eks.url, "https://", "")}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "iam_token_service" {
  name               = "iam-token-service"
  assume_role_policy = data.aws_iam_policy_document.iam_token_service_trust.json
}

# 2. Permission policy — templated from deploy/iam/policy.json.
resource "aws_iam_policy" "iam_token_service" {
  name = "iam-token-service"
  policy = templatefile("${path.module}/policy.json", {
    serviceaccount_events_topic_arn = aws_sns_topic.iam_serviceaccount_events.arn
    offboarding_queue_arn           = aws_sqs_queue.offboarding.arn
    offboarding_dlq_arn             = aws_sqs_queue.offboarding_dlq.arn
    glue_registry_arn               = aws_glue_registry.iam_serviceaccount_events.arn
    aws_region                      = data.aws_region.current.name
    aws_account_id                  = data.aws_caller_identity.current.account_id
  })
}

resource "aws_iam_role_policy_attachment" "iam_token_service" {
  role       = aws_iam_role.iam_token_service.name
  policy_arn = aws_iam_policy.iam_token_service.arn
}

# 3. OIDC role for the schema-registry GitHub Actions workflow (§13.5 — "AWS
#    access via OIDC, no long-lived keys"). Distinct from the runtime IRSA
#    role above — this one is assumed by GitHub's OIDC provider, scoped to
#    this repo, not by a Kubernetes ServiceAccount.
data "aws_iam_policy_document" "iam_token_service_ci_trust" {
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [aws_iam_openid_connect_provider.github_actions.arn]
    }
    condition {
      test     = "StringEquals"
      variable = "token.actions.githubusercontent.com:aud"
      values   = ["sts.amazonaws.com"]
    }
    condition {
      test     = "StringLike"
      variable = "token.actions.githubusercontent.com:sub"
      values   = ["repo:BCBP-SOLUTIONS-FZC-LLC/iam-token-service:*"]
    }
  }
}

resource "aws_iam_role" "iam_token_service_ci" {
  name               = "iam-token-service-ci-schema-registry"
  assume_role_policy = data.aws_iam_policy_document.iam_token_service_ci_trust.json
}

# Glue read/write for schema registration + CloudWatch metrics emission
# (schema-registry.yml's register/prune/metrics steps) — narrower than the
# runtime role's read-only Glue grant above, since CI also registers new
# schema versions.
data "aws_iam_policy_document" "iam_token_service_ci_permissions" {
  statement {
    sid    = "GlueSchemaRegistryReadWrite"
    effect = "Allow"
    actions = [
      "glue:GetRegistry",
      "glue:CreateRegistry",
      "glue:GetSchema",
      "glue:CreateSchema",
      "glue:GetSchemaVersion",
      "glue:RegisterSchemaVersion",
      "glue:GetSchemaByDefinition",
      "glue:ListSchemas",
      "glue:ListSchemaVersions",
      "glue:QuerySchemaVersionMetadata",
    ]
    resources = [
      aws_glue_registry.iam_serviceaccount_events.arn,
      "${aws_glue_registry.iam_serviceaccount_events.arn}/*",
    ]
  }
  statement {
    sid       = "CloudWatchMetrics"
    effect    = "Allow"
    actions   = ["cloudwatch:PutMetricData"]
    resources = ["*"]
  }
}

resource "aws_iam_role_policy" "iam_token_service_ci" {
  name   = "iam-token-service-ci-schema-registry"
  role   = aws_iam_role.iam_token_service_ci.id
  policy = data.aws_iam_policy_document.iam_token_service_ci_permissions.json
}
