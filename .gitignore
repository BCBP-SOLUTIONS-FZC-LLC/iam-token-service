# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# docker-compose's `secrets.go_private_token.file` — a real GitHub PAT with
# read access to the private BCBP-SOLUTIONS-FZC-LLC Go modules, never committed.
.go_private_token

# make test-ci coverage output, bin/ build artifacts
.coverage/
bin/
# A `go build ./cmd/<x>` run at the repo root (rather than `make build`,
# which always targets bin/) drops a same-named binary here — one
# `git add -A` from being committed (production-readiness review, TS-D15).
/server
/consumer
/rotator
/scheduler

# macOS
.DS_Store

# Editor/IDE
# .idea/
# .vscode/

# Claude Code agent worktrees (temporary, not project code)
.claude/worktrees/

# Staged PascalCase Glue schema copies (from make schema-register / CI —
# see .github/scripts/stage-produced-event-schemas.sh)
.tmp/
