    "securityDefinitions": {
        "TenantID": {
            "description": "Tenant UUID injected by the API gateway. Must match the :id path segment (§5.1).",
            "type": "apiKey",
            "name": "x-tenant-id",
            "in": "header"
        },
        "UserID": {
