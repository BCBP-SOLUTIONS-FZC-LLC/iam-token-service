{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceAccountCredentialRevokedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "principal_id",
    "version",
    "actor_id",
    "revoked_at"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
