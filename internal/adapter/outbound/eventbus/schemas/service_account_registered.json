{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceAccountRegisteredPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "principal_id",
    "principal_sub",
    "keycloak_client_id",
    "principal_type",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_sub": {
      "type": "string",
      "format": "uuid"
    },
    "keycloak_client_id": {
      "type": "string",
      "const": "platform-automation"
    },
    "principal_type": {
      "type": "string",
      "enum": [
        "platform_automation"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
