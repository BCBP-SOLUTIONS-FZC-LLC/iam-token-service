{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceAccountCredentialRotatedPayload",
  "description": "Payload of ServiceAccountCredentialRotated (LLD §7.5). Emitted by TS-1 on rotation (version > 1). Never carries a secret (TS-INV-2/EVT-2).",
  "type": "object",
  "required": ["tenant_id", "principal_id", "version", "prior_version", "expires_prior_at"],
  "additionalProperties": false,
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 2 },
    "prior_version": { "type": "integer", "minimum": 1 },
    "expires_prior_at": { "type": "string", "format": "date-time" }
  }
}
