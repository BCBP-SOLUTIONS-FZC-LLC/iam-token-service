{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceAccountRevokedPayload",
  "description": "Payload of ServiceAccountRevoked (LLD §7.5). Emitted when a principal is fully revoked (offboarding, §8.4).",
  "type": "object",
  "required": ["tenant_id", "principal_id", "revoked_at"],
  "additionalProperties": false,
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "principal_id": { "type": "string", "format": "uuid" },
    "revoked_at": { "type": "string", "format": "date-time" }
  }
}
