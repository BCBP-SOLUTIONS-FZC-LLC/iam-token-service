# ─────────────────────────────────────────────────────────────────────────
# iam-token-service — local dev environment
# ─────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust: `cp .env-example .env`. Values below assume
# `make docker-up` is running (Postgres/PgBouncer/Floci/OpenBao on their
# published host ports) and you're running the service natively via
# `make run` / `make run-consumer` — not the containerized app.
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=iam-token-service
# APP_ENV is also the metrics `environment` label: one of
# local | dev | test | staging | prod (platform-gincommon rejects aliases such
# as "development" or "production" at startup).
APP_ENV=dev
# Observability domain (`domain` label on every metric) — required by
# platform-gincommon; always "iam" for this service.
OBSERVABILITY_DOMAIN=iam
APP_PORT=8080
# /metrics is served on its own dedicated port/listener, separate from
# APP_PORT.
METRICS_PORT=9090
# server/consumer: on SIGTERM, /readyz turns 503 and the process waits this
# long (so the load balancer stops routing) before closing listeners.
SHUTDOWN_DRAIN_DELAY=5s

# ── PostgreSQL ───────────────────────────────────────────────────────────
# make docker-up exposes PgBouncer on 5536 (transaction pooling) and direct
# Postgres on 5535. Container-internal ports stay 5432 in the compose
# stack; only the host publish differs.
PG_HOST=localhost
PG_PORT=5536
PG_USER=serviceaccount_app
PG_PASSWORD=devpassword
PG_DBNAME=serviceaccount
PG_SSLMODE=disable
PG_MAX_CONNS=20
PG_MIN_CONNS=0
PG_BOUNCER_MODE=true
# Applied per transaction by platform-pgcommon (SET LOCAL), never to the
# migration DSN. Helm uses 60s for the rotator/scheduler CronJobs.
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s
PG_SLOW_QUERY_THRESHOLD=200ms

# Direct Postgres for migrations (bypasses PgBouncer — pg_advisory_lock is
# session-scoped and breaks under transaction pooling, TS-CONFIG-2).
MIGRATION_DATABASE_URL=postgres://serviceaccount_migrator:devpassword@localhost:5535/serviceaccount?sslmode=disable
# Every binary runs migrations at startup unless RUN_MIGRATIONS=false (Helm
# sets false and runs them once in a pre-install/pre-upgrade Job instead,
# with MIGRATE_ONLY=true: migrate, then exit 0).
RUN_MIGRATIONS=true
MIGRATE_ONLY=false

# BYPASSRLS, SELECT-only pool for cross-tenant reads: cmd/rotator's and
# cmd/scheduler's enumeration and cmd/server's exporters and JWKS
# known-tenant list (§4.3/RLS-7). In prod point at serviceaccount_reconciler; in dev falls
# back to DATABASE_URL and cross-tenant queries are RLS-filtered to 0 rows
# if left unset.
RECONCILER_DATABASE_URL=postgres://serviceaccount_reconciler:devpassword@localhost:5535/serviceaccount?sslmode=disable

# ── OpenBao (§6.3, §10.5, TS-CONFIG-3) ────────────────────────────────────
# make docker-up runs OpenBao in dev-mode on 8210 — its client here ONLY
# supports Kubernetes auth (no static-token override), and this stack has
# no real Kubernetes cluster for it to authenticate against. A real
# credential round-trip will fail locally until seeded by hand (see
# docker-compose.yml's openbao service comment) or exercised for real via
# `make test-integration` instead.
OPENBAO_ADDR=http://localhost:8210
OPENBAO_ROLE=iam-token-service
OPENBAO_KV_MOUNT=iam
# Path of the ServiceAccount JWT used for OpenBao's kubernetes auth. Empty =
# /var/run/secrets/kubernetes.io/serviceaccount/token. Helm points it at a
# projected token minted for the "openbao" audience.
OPENBAO_K8S_TOKEN_PATH=
# PEM CA bundle for OPENBAO_ADDR when its certificate isn't signed by a
# system root (read by the OpenBao SDK; Helm: openbao.caCertSecret).
BAO_CACERT=

# ── AWS SNS / SQS / Glue (Floci in dev) ───────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4568
GLUE_REGISTRY_NAME=iam-serviceaccount-events
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:iam-serviceaccount-events

# ── Outbox runner (platform-events config.LoadOutbox) ─────────────────────
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_DRAIN_TIMEOUT=30s
OUTBOX_PUBLISH_CONCURRENCY=4
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_STARTUP_JITTER=2s
OUTBOX_CLAIM_LEASE_DURATION=10m

# ── SQS — cmd/consumer's one inbound subscription (§7.1) ──────────────────
SQS_QUEUE_URL=http://localhost:4568/000000000000/tenant-lifecycle-tokensvc-q
SQS_CONCURRENCY=2
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60s
# platform_queue_depth / platform_dlq_depth sampling interval ("0s" disables).
SQS_QUEUE_DEPTH_INTERVAL=60s
# Exponential redelivery backoff for a failed message: 60s·2^(n-1) after
# its n-th delivery, capped at the max ("0s" turns it off).
SQS_RETRY_BACKOFF=60s
SQS_MAX_RETRY_BACKOFF=15m
SQS_HANDLER_TIMEOUT=45s
SQS_DRAIN_TIMEOUT=15s

# ── Rotation / reconciler tuning (§6.2, §8.3) ─────────────────────────────
ROTATION_DEFAULT_OVERLAP_SECONDS=300
ROTATION_DEFAULT_CADENCE_DAYS=90
# How long after issue a TS-1 rotation_id replay may still return the key
# (409 credential_replay_expired after); 0 = unlimited.
ROTATION_REPLAY_WINDOW=15m
PROCESSED_EVENTS_TTL_DAYS=8
# rls_violation_log retention (rotator prune) and the server's
# iam_rls_violations_total exporter interval.
RLS_VIOLATION_LOG_TTL_DAYS=30
RLS_VIOLATION_EXPORTER_INTERVAL=1m
# Server exporter for the keys_refresh_pending backlog gauges.
KEYS_REFRESH_EXPORTER_INTERVAL=30s
# Max rows one rotator sweep / scheduler scan processes per run; the rest
# wait for the next run.
ROTATOR_BATCH_LIMIT=500
SCHEDULER_BATCH_LIMIT=500
# CronJob in-process run budget and the /metrics window kept open after the
# run — together they must stay under the CronJob's activeDeadlineSeconds
# (240s in Helm).
ROTATOR_RUN_TIMEOUT=180s
ROTATOR_METRICS_SCRAPE_GRACE=15s
SCHEDULER_RUN_TIMEOUT=180s
SCHEDULER_METRICS_SCRAPE_GRACE=15s
# Rotator prune: batch size, and the age after which published outbox rows
# are deleted.
PRUNE_BATCH_LIMIT=10000
OUTBOX_PRUNE_OLDER_THAN=168h
# Server exporter for iam_token_service_rotation_overlap_active.
ROTATION_OVERLAP_GAUGE_INTERVAL=30s

# ── Realm Provisioner (RP-17) + JWKS (EXT-6, §16 TSQ-6 Resolved, TS-D14/15) ─
# cmd/rotator's and cmd/scheduler's outbound call to clear Keycloak's
# cached JWKS after every revoke/rotate; no reachable target in the local
# `make docker-up` stack (see docker-compose.yml's rotator/scheduler
# service comments) unless you point it at a running iam-realm-provisioner.
REALM_PROVISIONER_BASE_URL=http://localhost:8081
# Process-wide token-bucket rate limit on the unauthenticated-by-header
# JWKS route (§5.4).
JWKS_RATE_LIMIT_RPS=20
JWKS_RATE_LIMIT_BURST=40
# Per-tenant limit on the same route, so one tenant's (or a scanner's)
# traffic cannot starve Keycloak's fetch for another tenant.
JWKS_RATE_LIMIT_PER_TENANT_RPS=5
JWKS_RATE_LIMIT_PER_TENANT_BURST=10
# Shared bucket for tenants with no live credential, so a flood of made-up
# tenant ids cannot drain the global bucket Keycloak's real fetches use.
JWKS_RATE_LIMIT_UNKNOWN_TENANT_RPS=2
JWKS_RATE_LIMIT_UNKNOWN_TENANT_BURST=5
# How often the server reloads the set of tenants with a live credential
# (they use the global bucket; everyone else uses the unknown-tenant one).
JWKS_KNOWN_TENANTS_REFRESH=15s

# ── Swagger / AsyncAPI docs surface (§5.5/§7.3/§12.1) ─────────────────────
DOCS_ENABLED=true
DOCS_AUTH_TOKEN=

# ── OpenTelemetry + logging (read by platform-gincommon) ────────────────────
# The same set the Helm chart passes (values.yaml otel.* / logLevel /
# logSampling), with dev values. The service name comes from APP_NAME —
# OTEL_SERVICE_NAME is not read.
# "none" disables OTLP export in dev (gincommon v1.6.0) but keeps trace IDs;
# an empty value would mean localhost:4317 and a failed export every flush.
OTEL_EXPORTER_OTLP_ENDPOINT=none
# Plaintext gRPC to a local collector (Helm: false).
OTEL_EXPORTER_OTLP_INSECURE=true
# Head sampling ratio in [0,1]: sample everything in dev (Helm: 0.1).
OTEL_TRACES_SAMPLER_RATIO=1.0
# W3C baggage propagation.
OTEL_PROPAGATOR_BAGGAGE=false
# true only for edge services that accept an untrusted traceparent.
OTEL_TRACES_IGNORE_REMOTE_PARENT_SAMPLED=false
# debug | info | warn | error (Helm: info).
LOG_LEVEL=debug
# zap sampling of repetitive entries.
LOG_SAMPLING=false
